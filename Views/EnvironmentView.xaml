<UserControl x:Class="DnsRouteUI.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="环境与服务状态" Style="{StaticResource SectionHeader}" FontSize="18" />
            <TextBlock Text="规格第 5.1 节：展示 DNS Server 名称、服务状态、管理员权限、模块可用性等。" Foreground="#666" Margin="0,0,0,12" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="检测环境" Command="{Binding CheckCommand}" />
                <Button Content="读取配置" Command="{Binding ReadConfigCommand}" />
                <Button Content="导出诊断信息" Command="{Binding ExportDiagnosticsCommand}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                    <Setter Property="Text" Value="正在检测..." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="整体就绪：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="就绪" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusOk}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.IsReady}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="未就绪" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBad}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.IsReady}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 状态明细表 -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DNS Server 名称" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.DnsServerName}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS Server 服务状态" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4">
                        <Run Text="{Binding Status.DnsServiceRunning, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="当前账户管理员权限" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.IsAdministrator}" Margin="0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="DnsServer PowerShell 模块" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.DnsServerModuleAvailable}" Margin="0,4" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="手工规则数" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status.RuleCount}" Margin="0,4" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="配置档数" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Status.ProfileCount}" Margin="0,4" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="默认策略状态" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Status.DefaultPolicyConfigured}" Margin="0,4" />

                    <!-- 条件转发开关（核心交互控件） -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="按条件转发（DNS 分流）" Foreground="#555" Margin="0,4" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding ConditionalForwardingEnabled, Mode=TwoWay}" VerticalAlignment="Center" Content="启用" FontWeight="Bold" />
                        <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" FontSize="11">
                            <Run Text="Server 状态：" />
                            <Run Text="{Binding Status.ConditionalForwardingActiveOnServer, Mode=OneWay, StringFormat={}{0}}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="说明" Foreground="#888" Margin="0,4" FontSize="11" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                               Text="开启时按客户端网段分流到不同上游 DNS；关闭时 DNS Server 回退默认递归行为。修改后需在&quot;变更预览与应用&quot;中应用生效。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="最近一次应用时间" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Status.LastAppliedAt, TargetNullValue=无}" Margin="0,4" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="最近一次应用结果" Foreground="#555" Margin="0,4" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Status.LastApplyResult, TargetNullValue=无}" Margin="0,4" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Text="操作日志" Style="{StaticResource SectionHeader}" />
            <ListBox ItemsSource="{Binding LogLines}" Height="160" FontFamily="Consolas" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

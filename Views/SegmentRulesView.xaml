<UserControl x:Class="DnsRouteUI.Views.SegmentRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="网段策略" Style="{StaticResource SectionHeader}" FontSize="18" />
            <TextBlock Text="规格第 5.3、5.4 节：按客户端 IPv4 网段匹配，更精确网段优先。默认策略不可删除。" Foreground="#666" Margin="0,0,0,12" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="新建规则" Command="{Binding NewRuleCommand}" />
                <Button Content="编辑" Command="{Binding EditRuleCommand}" />
                <Button Content="删除" Command="{Binding DeleteRuleCommand}" />
                <Button Content="上移" Command="{Binding MoveUpCommand}" />
                <Button Content="下移" Command="{Binding MoveDownCommand}" />
                <Button Content="启用/禁用" Command="{Binding ToggleEnabledCommand}" />
            </StackPanel>

            <!-- 规则表格 -->
            <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" Height="220"
                      BorderBrush="#DDD" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50" />
                    <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60" />
                    <DataGridTextColumn Header="规则名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="客户端网段" Binding="{Binding ClientSubnet}" Width="150" />
                    <DataGridTextColumn Header="解析配置档" Binding="{Binding ResolverProfileName}" Width="*" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 默认策略（规格第 5.4 节：始终显示在最后） -->
            <Border BorderBrush="#4C8DCE" BorderThickness="1" CornerRadius="4" Background="#F0F6FC" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="默认策略（不可删除 · 不可移动）" FontWeight="Bold" Foreground="#1B4F7A" VerticalAlignment="Center" />
                        <TextBlock Text="未匹配任何网段的客户端使用此策略" Foreground="#666" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="上游解析配置档：" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                      SelectedItem="{Binding DefaultSelectedProfile}"
                                      DisplayMemberPath="Name" MinWidth="220" />
                            <CheckBox Content="启用" IsChecked="{Binding DefaultPolicy.Enabled}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="保存默认策略" Command="{Binding SaveDefaultCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 编辑表单 -->
            <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}"
                    BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding IsNew, StringFormat=新建规则, TargetNullValue=编辑规则}" Style="{StaticResource SectionHeader}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="规则名称" Foreground="#555" />
                            <TextBox Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="客户端 IPv4 网段 (CIDR)" Foreground="#555" />
                            <TextBox Text="{Binding SelectedRule.ClientSubnet, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="上游解析配置档" Foreground="#555" />
                            <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                      SelectedValue="{Binding SelectedRule.ResolverProfileId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="备注" Foreground="#555" />
                            <TextBox Text="{Binding SelectedRule.Note, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ValidationMessages}" Foreground="#B00020" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="保存" Command="{Binding SaveRuleCommand}" />
                        <Button Content="取消" Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

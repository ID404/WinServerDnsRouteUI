<Application x:Class="DnsRouteUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DnsRouteUI.ViewModels"
             xmlns:v="clr-namespace:DnsRouteUI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ViewModel -> View 映射 -->
            <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                <v:EnvironmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResolverProfilesViewModel}">
                <v:ResolverProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SegmentRulesViewModel}">
                <v:SegmentRulesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewApplyViewModel}">
                <v:PreviewApplyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TestLogViewModel}">
                <v:TestLogView />
            </DataTemplate>

            <!-- 全局样式 -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="MinWidth" Value="72" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="4,2" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="4,2" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>
            <Style x:Key="StatusOk" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#1B7F3B" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="StatusBad" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B00020" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
